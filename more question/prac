n, m = map(int, input().split())
arr = list(map(int, input().split()))

arr.sort()
left = 0
right = arr[-1]
answer = 0

while left <= right :
    mid = (left + right) // 2
    
    sum = 0
    for i in range(n) :
        if arr[i] > mid :
            sum += arr[i] - mid
    
    if sum >= m :
        answer = mid
        left = mid + 1
    else :
        right = mid - 1

print(answer)
        

    